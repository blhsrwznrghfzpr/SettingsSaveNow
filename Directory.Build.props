<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>blhsrwznrghfzpr</Authors>
    <RepositoryUrl>https://github.com/blhsrwznrghfzpr/SettingsSaveNow</RepositoryUrl>
    <PackageProjectUrl>https://github.com/blhsrwznrghfzpr/SettingsSaveNow</PackageProjectUrl>
    <Description>Adds a button to save Resonite settings without exiting the game.</Description>
    <AssemblyName>SettingsSaveNow</AssemblyName>
    <RootNamespace>SettingsSaveNow</RootNamespace>
    <ResoniteTarget>client</ResoniteTarget>
    <ResoniteProjectType>mod</ResoniteProjectType>
    <ResoniteInstallOnBuild>false</ResoniteInstallOnBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
